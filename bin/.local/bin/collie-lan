#!/usr/bin/env bash
# On/off switch for the collie LAN front door: Caddy bound to this Mac's home
# LAN address, TLS from Caddy's local CA, mTLS as the per-device gate: only
# devices holding a cert from the client CA under ~/.config/collie-lan/mtls
# can connect, and their device id comes from the cert's SAN.
# The collie bridge itself stays on 127.0.0.1 and is never touched here.
#
#   collie-lan on|off|toggle   start/stop Caddy; `on` refuses off the home network (--force overrides)
#   collie-lan status          "on" or "off"
#   collie-lan glyph           tab-bar text: ' on' or ' off'
#   collie-lan init            detect LAN address + router MAC, write the env file
#   collie-lan cert <device>   issue a client cert (.p12) for a device; creates the CA on first use
#   collie-lan p12 <device>    re-wrap an existing device cert into a .p12 with a fresh import password
#
# Port 8443, not 443: macOS denies non-root binds below 1024.
#
# Env file: ~/.config/collie-lan/env. The device id must be in COLLIE_DEVICE_ALLOWLIST
# of the collie .env, or the device is read-only.
set -uo pipefail

cfg_dir="${COLLIE_LAN_DIR:-$HOME/.config/collie-lan}"
env_file="$cfg_dir/env"
pidfile="$cfg_dir/caddy.pid"
logfile="$cfg_dir/caddy.log"
caddyfile="${COLLIE_LAN_CADDYFILE:-$HOME/.config/caddy/Caddyfile}"
herdr="${HERDR_BIN_PATH:-herdr}"

notify() { "$herdr" notification show "$1" --body "${2:-}" --sound none >/dev/null 2>&1 || true; }
die() { echo "collie-lan: $*" >&2; notify "Remote control" "$*"; exit 1; }

load_env() {
  [ -r "$env_file" ] || die "no $env_file; run: collie-lan init"
  set -a
  # shellcheck source=/dev/null
  . "$env_file"
  set +a
}

default_iface() { route -n get default 2>/dev/null | awk '/interface:/{print $2}'; }

# Normalised aa:bb:cc:dd:ee:ff; arp drops leading zeros, so pad before comparing.
gateway_mac() {
  local gw mac
  gw=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2}')
  [ -n "$gw" ] || return 0
  mac=$(arp -n "$gw" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="at"){print $(i+1); exit}}')
  case "$mac" in *:*) ;; *) return 0 ;; esac
  printf '%s' "$mac" | awk -F: '{for(i=1;i<=NF;i++) printf "%s%02s", (i>1?":":""), tolower($i)}' | tr ' ' 0
}

running() { [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }
at_home() { [ -n "$COLLIE_LAN_GATEWAY_MAC" ] && [ "$(gateway_mac)" = "$COLLIE_LAN_GATEWAY_MAC" ]; }

cmd_on() {
  load_env
  if running; then echo on; return; fi
  if [ "${1:-}" != "--force" ] && ! at_home; then
    die "not on the home network (gateway MAC mismatch); use: collie-lan on --force"
  fi
  [ "$(ipconfig getifaddr "$(default_iface)" 2>/dev/null)" = "$COLLIE_LAN_HOST" ] ||
    die "this Mac is not $COLLIE_LAN_HOST; check the DHCP reservation"
  # Not captured: the forked server inherits stdout and a $(...) would never see EOF.
  caddy start --config "$caddyfile" --adapter caddyfile --pidfile "$pidfile" >"$logfile" 2>&1 ||
    die "caddy failed to start: $(grep -m1 -o 'Error: .*' "$logfile" || tail -1 "$logfile")"
  notify "Remote control on" "https://$COLLIE_LAN_HOST:${COLLIE_LAN_PORT:-8443}"
  echo on
}

cmd_off() {
  if ! running; then echo off; return; fi
  caddy stop >/dev/null 2>&1 || kill "$(cat "$pidfile")" 2>/dev/null
  rm -f "$pidfile"
  notify "Remote control off"
  echo off
}

cmd_init() {
  local ip mac
  # shellcheck source=/dev/null
  [ -r "$env_file" ] && . "$env_file"
  ip=$(ipconfig getifaddr "$(default_iface)" 2>/dev/null); mac=$(gateway_mac)
  if [ -z "$ip" ] || [ -z "$mac" ]; then die "no LAN address or gateway found; run this at home"; fi
  mkdir -p "$cfg_dir"; umask 077
  cat >"$env_file" <<EOT
COLLIE_LAN_HOST=$ip
COLLIE_LAN_PORT=${COLLIE_LAN_PORT:-8443}
COLLIE_LAN_GATEWAY_MAC=$mac
COLLIE_LAN_MTLS_CA=$cfg_dir/mtls/client-ca.crt
EOT
  echo "wrote $env_file: https://$ip:${COLLIE_LAN_PORT:-8443}, home gateway $mac"
  running && echo "Caddy is running on the old settings: collie-lan off && collie-lan on"
  return 0
}

cmd_cert() {
  local dev=$1 d="$cfg_dir/mtls" pw
  [ -n "$dev" ] || die "usage: collie-lan cert <device-id>"
  mkdir -p "$d"; umask 077
  [ -f "$d/client-ca.crt" ] || openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -keyout "$d/client-ca.key" -out "$d/client-ca.crt" \
    -subj "/CN=collie-lan client CA" 2>/dev/null || die "CA generation failed"
  openssl req -newkey rsa:2048 -nodes -keyout "$d/$dev.key" -out "$d/$dev.csr" \
    -subj "/CN=$dev" 2>/dev/null || die "key/csr generation failed"
  # The SAN is the device id collie sees; it must be in COLLIE_DEVICE_ALLOWLIST for writes.
  # Explicit -CAserial: LibreSSL derives the default path by truncating the CA
  # path at the first dot, which lands outside $d when $HOME contains one.
  openssl x509 -req -in "$d/$dev.csr" -CA "$d/client-ca.crt" -CAkey "$d/client-ca.key" \
    -CAcreateserial -CAserial "$d/client-ca.srl" -days 3650 -out "$d/$dev.crt" \
    -extfile <(printf 'subjectAltName=DNS:%s\nextendedKeyUsage=clientAuth\n' "$dev") 2>/dev/null \
    || die "cert signing failed"
  rm -f "$d/$dev.csr"
  export_p12 "$dev"
}

# The import password only guards the .p12 in transit (AirDrop); it is printed
# once and stored nowhere. Lost it? Run this again: same cert, new wrapper.
export_p12() {
  local dev=$1 d="$cfg_dir/mtls" pw
  if [ ! -f "$d/$dev.key" ] || [ ! -f "$d/$dev.crt" ]; then die "no cert for '$dev' under $d; issue one: collie-lan cert $dev"; fi
  pw=$(openssl rand -hex 4)
  openssl pkcs12 -export -inkey "$d/$dev.key" -in "$d/$dev.crt" \
    -passout "pass:$pw" -out "$d/$dev.p12" || die "p12 export failed"
  chmod 600 "$d/$dev.p12"
  echo "wrote $d/$dev.p12 (import password: $pw)"
  echo "iPhone/iPad: AirDrop the .p12 and root.crt, install both via Settings > General > VPN & Device Management,"
  echo "trust the root under Settings > General > About > Certificate Trust Settings, then pick '$dev' when Safari asks."
}

case "${1:-}" in
  on)     cmd_on "${2:-}" ;;
  off)    cmd_off ;;
  toggle) if running; then cmd_off; else cmd_on "${2:-}"; fi ;;
  status) if running; then echo on; else echo off; fi ;;
  glyph)  if running; then printf ' on'; else printf ' off'; fi; exit 0 ;;
  init)   cmd_init ;;
  cert)   cmd_cert "${2:-}" ;;
  p12)    export_p12 "${2:-}" ;;
  *)      sed -n 2,15p "$0"; exit 1 ;;
esac
