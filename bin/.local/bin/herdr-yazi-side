#!/usr/bin/env bash
# Toggle a yazi pane on the left of the focused pane. `plugin pane open` only
# splits right or down, so open right and swap into the left slot.
set -uo pipefail
herdr="${HERDR_BIN_PATH:-herdr}"

me="${HERDR_ACTIVE_PANE_ID:-}"
[ -n "$me" ] || me=$("$herdr" pane list 2>/dev/null | jq -r '.result.panes[] | select(.focused) | .pane_id' | head -1)
[ -n "$me" ] || exit 1
pane=$("$herdr" pane get "$me" 2>/dev/null | jq -c '.result.pane')
tab=$(jq -r '.tab_id' <<<"$pane"); cwd=$(jq -r '.cwd // empty' <<<"$pane")

existing=$("$herdr" pane list 2>/dev/null | jq -r --arg tab "$tab" '.result.panes[] | select(.tab_id==$tab and .label=="yazi") | .pane_id' | head -1)
if [ -n "$existing" ]; then
  exec "$herdr" pane close "$existing" >/dev/null 2>&1
fi

# yazi reads $PWD before getcwd (to keep symlinked paths), and a plugin pane
# inherits the server's PWD, so --cwd alone still opens yazi in $HOME.
new=$("$herdr" plugin pane open --plugin local.user --entrypoint yazi --placement split \
        --direction right --target-pane "$me" ${cwd:+--cwd "$cwd" --env "PWD=$cwd"} --no-focus 2>/dev/null |
      jq -r '.result.plugin_pane.pane.pane_id // empty')
[ -n "$new" ] || exit 1
"$herdr" pane swap --source-pane "$new" --target-pane "$me" >/dev/null 2>&1
# A swap drags focus along with the slot; put it back on the work pane.
"$herdr" pane focus --direction right --pane "$new" >/dev/null 2>&1 || true
