#!/usr/bin/env bash
# Directory picker for "new workspace". The palette's own workspace.new asks for
# a typed path (source: "input"); its select source only knows workspaces, tabs
# and agents, so a directory picker has to live outside it.
#
# Lists only the top level of each root, so the list is instant. Anything else
# is a `z` away; walking $HOME for .git dirs took 1.5s and found nothing useful.
set -uo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"
secret="$HOME/.config/zsh/config/.env.secret"

# herdr may have been started without the shell env, so fall back to the file.
if [ -z "${HERDR_NEW_WORKSPACE_ROOTS:-}" ] && [ -f "$secret" ]; then
  eval "$(grep -E '^(export )?HERDR_NEW_WORKSPACE_ROOTS=' "$secret")"
fi
IFS=, read -ra roots <<<"${HERDR_NEW_WORKSPACE_ROOTS:-$HOME}"

list() {
  local r
  for r in "${roots[@]}"; do
    r="${r## }"; r="${r%% }"; r="${r/#\~/$HOME}"; r="${r%/}"
    [ -d "$r" ] || continue
    fd --max-depth 1 --type d . "$r" 2>/dev/null |
      sed "s|/\$||" | awk -v home="$HOME" '{l=$0; sub("^"home, "~", l); print l "\t" $0}'
  done | sort
}

sel=$(list | fzf --delimiter='\t' --with-nth=1 --prompt="workspace ▸ " \
        --height=100% --border=none --no-preview | cut -f2) || exit 0
[ -n "$sel" ] || exit 0

"$herdr" workspace create --cwd "$sel" --focus >/dev/null 2>&1
