#!/usr/bin/env bash
# Prints a magnifier when the focused pane is zoomed, nothing otherwise.
# A tab_bar_right command entry, so it must always exit 0 and stay quiet.
set -uo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"
command -v "$herdr" >/dev/null 2>&1 || exit 0

if "$herdr" pane layout --current 2>/dev/null | grep -q '"zoomed":true'; then
  printf '🔍'
fi
exit 0
