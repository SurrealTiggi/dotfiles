#!/usr/bin/env bash
# Toggle for the agenda popup, since herdr's own popup keybind only opens.
# popup.close answers popup_not_open when there is none, which is the only way
# to test for one: the session snapshot does not track popups.
#
# Closing ends the TUI cleanly, no orphan. With `daemon: true` the background
# process keeps running; without it, closing quits agenda outright.
set -uo pipefail
sock="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
# A shell keybind runs with a minimal PATH, so resolve herdr explicitly.
herdr="${HERDR_BIN_PATH:-$HOME/.local/bin/herdr}"

closed=$(printf '{"id":"c","method":"popup.close","params":{}}\n' | nc -U -w 2 "$sock" 2>/dev/null)
case $closed in
  *popup_not_open*) ;;        # none open, fall through and open one
  *) exit 0 ;;                # closed the open one
esac

# Placement comes from the plugin declaration (popup); --placement has no popup value.
"$herdr" plugin pane open --plugin local.user --entrypoint agenda --focus >/dev/null 2>&1
